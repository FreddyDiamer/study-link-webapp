# Проверка типов перед коммитом. vue-tsc — единственная автоматическая
# верификация в проекте (тестов и линтера нет), поэтому она обязательна.
# Обойти в исключительном случае: git commit --no-verify

echo "→ Проверка типов (vue-tsc)…"

if ! pnpm type-check; then
  echo ""
  echo "✗ Коммит остановлен: есть ошибки типов."
  echo "  Почините их или, если это осознанно, используйте git commit --no-verify."
  exit 1
fi

echo "✓ Типы в порядке"
